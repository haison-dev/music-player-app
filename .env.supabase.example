# Supabase PostgreSQL for Prisma
# Dashboard -> Connect -> ORM/Prisma or Connection string.
#
# Recommended for this app/API on a persistent server:
# Use Supavisor Session pooler. It usually ends with :5432/postgres.
DATABASE_URL="postgres://prisma.[PROJECT-REF]:[PRISMA-PASSWORD]@[DB-REGION].pooler.supabase.com:5432/postgres?schema=public"

# Use the same value as DATABASE_URL unless you have a separate direct connection
# available for migrations.
DIRECT_URL="postgres://prisma.[PROJECT-REF]:[PRISMA-PASSWORD]@[DB-REGION].pooler.supabase.com:5432/postgres?schema=public"

REDIS_URL="redis://localhost:6379"
JWT_ACCESS_SECRET="replace-me-access"
JWT_REFRESH_SECRET="replace-me-refresh"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="music-platform"
S3_ACCESS_KEY_ID="music"
S3_SECRET_ACCESS_KEY="music12345"
API_PORT="4000"
VITE_API_URL="http://localhost:4000"
