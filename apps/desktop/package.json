{
  "name": "@music/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "src/main/main.cjs",
  "scripts": {
    "dev": "concurrently -n vite,electron -c magenta,green \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@music/shared": "*",
    "@tanstack/react-query": "^5.76.1",
    "lucide-react": "^0.511.0",
    "music-metadata": "^11.12.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.4.1",
    "cross-env": "^7.0.3",
    "electron": "35.2.1",
    "electron-builder": "^26.0.12",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "dev.haison.musicplatform",
    "productName": "Music Platform",
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/preload/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "../../assets/icons"
    },
    "win": {
      "target": "nsis",
      "icon": "../../assets/icons/icon.ico"
    }
  }
}
